# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.python-version
*.pyc
*.pyo
*.pyd

# ── Virtual environments ───────────────────────────────────────
venv/
.venv/
env/
.venv*/

# ── IDE / Editors ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*
*.sublime-workspace
*.vscode*

# ── OS junk ────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.DS_Store
._*
.Spotlight-V100
.Trashes
$RECYCLE.BIN/

# ── MegaDL — Runtime data (generated, never commit) ────────────
# Logs
*.log
*.log.*

# SQLite database (runtime data, NOT schema)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Download files
downloads/
temp/

# Settings (auto-generated with local paths/secrets)
settings.json
*.session

# Test artifacts
tests/*.db
tests/*.db-shm
tests/*.db-wal
tests/downloads/

# Server logs (from test runs)
server*.log

# Environment / Secrets
.env
.env.*
*.env
cookies.txt
credentials.json
*.credentials
*.token
secret*

# ── Node / npm (if ever used) ─────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ── PHP ────────────────────────────────────────────────────────
# Runtime logs/settings
backend-php/logs/
backend-php/config/settings.json

# ── OS / Editor safety net ────────────────────────────────────
# Any junction/symlink artifacts (Windows)
[Cc]:\\*
[Dd]:\\*
[Ee]:\\*
